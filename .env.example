# Conexão com pool (usar no app Next.js)
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Conexão direta (usar em migrações e ferramentas como DBeaver/psql)
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Chave que assina os tokens de sessao (minimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use um valor diferente em cada ambiente (Preview e Production) e cadastre também na Vercel.
# O valor de exemplo abaixo e recusado pelo app.
SESSION_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# Opcional. Libera o GET /api/health/db (estado do banco) para quem enviar este valor em
# "Authorization: Bearer <valor>". Minimo 16 caracteres; sem ele, a rota fica desligada (404).
# Gere com o mesmo comando do SESSION_SECRET.
HEALTH_DB_SECRET=
