# Conexão com pool (usar no app Next.js)
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Conexão direta (usar em migrações e ferramentas como DBeaver/psql)
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Chave que assina os tokens de sessao (minimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use um valor diferente em cada ambiente (Preview e Production) e cadastre também na Vercel.
# O valor de exemplo abaixo e recusado pelo app.
SESSION_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# Endereço público do app, só o endereço: sem barra no fim, caminho nem parâmetros
# (ex.: https://bike-ilha-club.vercel.app). Opcional por enquanto, porque nenhuma rota lê essa
# variável; se vier, é conferida (precisa ser https em production, exceto localhost).
APP_URL="http://localhost:3000"

# Opcional. Libera o GET /api/health/db (estado do banco) para quem enviar este valor em
# "Authorization: Bearer <valor>". Minimo 16 caracteres; sem ele, a rota fica desligada (404).
# Gere com o mesmo comando do SESSION_SECRET.
HEALTH_DB_SECRET=

# Só para o seed do ambiente de desenvolvimento (db/seeds). Senhas de teste das contas
# admin@bikeilha.test e operador@bikeilha.test: 8+ caracteres, com letra e número.
# Use valores seus, só no .env.local, e nunca em production.
SEED_ADMIN_SENHA=
SEED_OPERADOR_SENHA=

# Pagamento por Pix com a Stripe (rotas 16, 17 e 18). Nunca coloque os valores reais aqui.
# Chave secreta da conta: sk_test_... no sandbox (sem dinheiro de verdade), sk_live_... em produção.
# Pegue em https://dashboard.stripe.com/apikeys. A conta precisa ter o Pix ativado em
# Configurações > Métodos de pagamento. Em production a chave é obrigatória: sem ela o app avisa na
# subida (e responde 500 em tudo). Em desenvolvimento, sem a chave, POST /api/pagamentos responde 502.
STRIPE_SECRET_KEY=
# Segredo de assinatura do webhook (whsec_...), do endpoint https://<seu-dominio>/api/pagamentos/webhook
# (também obrigatório em production), com os eventos payment_intent.succeeded, payment_intent.payment_failed e payment_intent.canceled.
# Localmente: stripe listen --forward-to localhost:3000/api/pagamentos/webhook (mostra o whsec_).
STRIPE_WEBHOOK_SECRET=

# Só para scripts/teste-de-estresse.mjs (ferramenta de desenvolvimento, o app não lê estas duas).
# Endereço do servidor que o teste ataca. Se faltar, vale http://localhost:3000.
# BASE_URL="http://localhost:3000"
# Libera o teste contra um servidor que NÃO é local (ele cria contas, reservas e Pix). Só em ambiente
# de teste, nunca em produção.
# ESTRESSE_PERMITIR_REMOTO=sim
