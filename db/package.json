{
  "name": "bike-ilha-club-db",
  "version": "1.0.0",
  "private": true,
  "description": "Migrations do banco de dados do Bike Ilha Club",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrar": "node migrar.mjs up",
    "migrar:simular": "node migrar.mjs up --simular",
    "migrar:reverter": "node migrar.mjs down",
    "migrar:status": "node migrar.mjs status",
    "seed:dev": "node seeds/aplicar-seed.mjs",
    "teste:unit": "node tests/unit/constraints.test.mjs",
    "teste:whitebox": "node tests/whitebox/schema.test.mjs",
    "teste:blackbox": "node tests/blackbox/reserva_e_pagamento.test.mjs",
    "teste:ocupacao": "node tests/blackbox/ocupacao_bicicleta.test.mjs",
    "teste:reserva-e-pagamento": "npm run teste:unit && npm run teste:whitebox && npm run teste:blackbox && npm run teste:ocupacao"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
